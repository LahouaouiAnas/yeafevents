# Copy to .env.local for local development. Never commit .env.local.
# In production (Hostinger), set these in the app's environment variables BEFORE building:
# NEXT_PUBLIC_* values are inlined into the build, so changing them requires a rebuild.

# Public canonical URL of the site, without trailing slash (canonical, hreflang, sitemap, Open Graph, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://yeafevents.com
# Indexing switch. Keep "false" on local/staging so search engines never index them.
# Set to "true" ONLY on the production deployment.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Sanity CMS (projects, blog posts, testimonials; Studio at /studio) ---
# Leave the project ID empty to build without Sanity (those collections stay empty).
NEXT_PUBLIC_SANITY_PROJECT_ID=m721osum
NEXT_PUBLIC_SANITY_DATASET=production
# Server-only. Shared with the Sanity webhook that calls /api/revalidate on publish.
SANITY_REVALIDATE_SECRET=
# Server-only, Sanity API token with Editor rights: saves quote requests and, once the
# dataset is private (it should be: requests are personal data), lets the site read content.
SANITY_API_WRITE_TOKEN=

# --- Quote form emails (SMTP; Hostinger mailbox by default) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@yeafevents.com
# Server-only: the mailbox password.
SMTP_PASSWORD=
# Where requests are sent (defaults to the contact email in src/config/site.ts).
QUOTE_TO_EMAIL=contact@yeafevents.com

# --- Cloudinary (not wired yet: leave empty) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Server-only. Never prefix with NEXT_PUBLIC_.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
